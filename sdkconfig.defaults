# Shared base configuration — board-specific overrides are in boards/*.sdkconfig

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# All supported boards have 4 MB flash; partition table needs 3.1 MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# MQTT receive buffer (transmit buffer is set dynamically in mqtt.c)
CONFIG_MQTT_BUFFER_SIZE=8192

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
